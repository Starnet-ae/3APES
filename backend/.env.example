# Local development. Do not commit real secrets.
BIND_ADDRESS=127.0.0.1:8080
SQLITE_PATH=./data/3apes.db
PUBLIC_ORIGIN=http://localhost:5173
# Temporarily true to create demo accounts; turn off for public demo
SIGNUP_ENABLED=true
# OpenAI-compatible inference endpoint running in a TEE (verification is separate)
LLM_BASE_URL=https://YOUR-TEE-PROVIDER/v1
LLM_API_KEY=REPLACE_WITH_PROVIDER_SECRET
MODEL_SMALL_ID=
MODEL_MEDIUM_ID=YOUR_CONFIGURED_MODEL_ID
MODEL_LARGE_ID=
